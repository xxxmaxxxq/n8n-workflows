      "parameters": {
        "jsCode": "// НАСТРОЙКИ КЛИЕНТА — поменять на реальные\nconst MANAGER_CHAT_ID = '000000000';   // chat_id менеджера\nconst OWNER_CHAT_ID   = '000000000';   // chat_id владельца для эскалации\nconst COMPANY         = 'Название компании';\n\nconst body = $json.body || $json;\n\n// Нормализация: форма может слать поля как угодно\nconst pick = (...keys) => {\n  for (const k of keys) {\n    if (body[k] !== undefined && String(body[k]).trim() !== '') return String(body[k]).trim();\n  }\n  return '';\n};\n\nconst phoneRaw = pick('phone', 'tel', 'telephone', 'Телефон', 'phone_number');\nconst phone = phoneRaw.replace(/[^\\d+]/g, '');\n\nconst id = 'Z-' + Date.now().toString(36).toUpperCase();\nconst now = new Date().toLocaleString('ru-RU', { timeZone: 'Europe/Moscow' });\n\nreturn [{\n  json: {\n    id,\n    createdAt: now,\n    name: pick('name', 'Name', 'Имя', 'fio') || 'не указано',\n    phone: phone || 'не указан',\n    email: pick('email', 'Email', 'Почта'),\n    comment: pick('comment', 'message', 'Комментарий', 'text') || 'без комментария',\n    source: pick('source', 'utm_source', 'Источник') || 'сайт',\n    status: 'новая',\n    managerChatId: MANAGER_CHAT_ID,\n    ownerChatId: OWNER_CHAT_ID,\n    company: COMPANY\n  }\n}];"
      },
      "id": "3cdb1c7b-182d-401d-883d-a99e5c003707",
