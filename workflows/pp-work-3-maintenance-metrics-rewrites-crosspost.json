      "parameters": {
        "jsCode": "const raw=$json.output?.[0]?.content?.[0]?.text||$json.text||''; const clean=raw.replace(/^```json\\s*|```$/g,'').trim(); let x; try{x=JSON.parse(clean)}catch(e){x={topics:[{title:'Как использовать нейросети для экономии времени каждый день',topic_key:'ai-time-saving',angle:'Практическая инструкция',trend_source:'fallback'}]};} const topics=x.topics||[]; const pick=topics[Math.floor(Math.random()*Math.max(topics.length,1))]||topics[0]; return [{json:{...pick,run_id:$('Config').first().json.run_id,chat_id:$('Config').first().json.chat_id,supabase_url:$('Config').first().json.supabase_url,created_at:new Date().toISOString()}}];"
