        "jsCode": "const data = $json;\nconst m = data.message || data.сообщение || data;\nconst text = (m.text || m.текст || data.text || data.текст || '').toString().trim();\nconst chat = m.chat || m.чат || {};\nconst from = m.from || m.от || {};\n\nconst chatId = chat.id || chat.идентификатор || data.chat_id;\nconst userId = from.id || from.идентификатор;\n\nconst match = text.match(/^\\/(approve|reject|revise|утвердить|отклонить|доработать)\\s+([a-zA-Z0-9_-]+)/i);\n\nif (!match) return [];\n\nlet command = match[1].toLowerCase();\n// Переводим русские команды в английские\nif (command === 'утвердить') command = 'approve';\nif (command === 'отклонить') command = 'reject';\nif (command === 'доработать') command = 'revise';\n\nreturn [{\n  json: {\n    command: command,\n    run_id: match[2],\n    chat_id: chatId,\n    supabase_url: 'https://sxmohmchavqpccszmrtv.supabase.co',\n    user_id: userId\n  }\n}];"
