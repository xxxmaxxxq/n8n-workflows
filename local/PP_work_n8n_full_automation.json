  {
    "name":"PP_work — 2. Telegram approval + Playwright publish",
    "nodes":[
      {"parameters":{"updates":["message"],"additionalFields":{}},"id":"ap-trigger","name":"Telegram Trigger — commands","type":"n8n-nodes-base.telegramTrigger","typeVersion":1.5,"position":[-700,0],"credentials":{"telegramApi":{"id":"rIVYVtqdOx6zlczs","name":"Telegram account"}}},
      {"parameters":{"jsCode":"const m=$json.message||{}; const text=m.text||''; const match=text.match(/^\\/(approve|reject|revise)\\s+([a-zA-Z0-9-]+)/); if(!match) return []; return [{json:{command:match[1],run_id:match[2],chat_id:m.chat.id,supabase_url:'https://sxmohmchavqpcszmrtv.supabase.co',user_id:m.from?.id}}];"},"id":"ap-parse","name":"Parse command + auth","type":"n8n-nodes-base.code","typeVersion":2,"position":[-460,0]},
      {"parameters":{"method":"GET","url":"={{$json.supabase_url}}/rest/v1/articles?select=*&run_id=eq.{{$json.run_id}}&limit=1","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{$env.SUPABASE_SERVICE_ROLE_KEY}}"},{"name":"Authorization","value":"=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"}]},"options":{}},"id":"ap-read","name":"Supabase — get article","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-220,0]},
      {"parameters":{"jsCode":"const cmd=$('Parse command + auth').first().json; const row=$json[0]||$json; if(cmd.command==='reject') return [{json:{...cmd,status:'rejected',message:'Статья отклонена: '+cmd.run_id}}]; if(cmd.command==='revise') return [{json:{...cmd,status:'revision_requested',message:'Статья отправлена на доработку: '+cmd.run_id}}]; return [{json:{...cmd,...row,status:'approved',message:'Статья подтверждена и передана в очередь публикации: '+cmd.run_id}}];"},"id":"ap-route","name":"Approve / reject / revise","type":"n8n-nodes-base.code","typeVersion":2,"position":[20,0]},
      {"parameters":{"method":"PATCH","url":"={{$json.supabase_url}}/rest/v1/articles?run_id=eq.{{$json.run_id}}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{$env.SUPABASE_SERVICE_ROLE_KEY}}"},{"name":"Authorization","value":"=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{JSON.stringify({status:$json.status,updated_at:new Date().toISOString()})}}","options":{}},"id":"ap-status","name":"Supabase — update status","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[260,0]},
      {"parameters":{"method":"POST","url":"={{$env.PLAYWRIGHT_PUBLISH_URL || 'https://YOUR-PLAYWRIGHT-SERVICE/publish'}}","sendHeaders":true,"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{JSON.stringify({run_id:$json.run_id,title:$json.title,content:$json.content,image_urls:$json.image_urls})}}","options":{}},"id":"ap-playwright","name":"Playwright — publish to Dzen (external service)","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[500,140],"disabled":true},
      {"parameters":{"jsCode":"return [{json:{chat_id:$('Parse command + auth').first().json.chat_id,text:$json.message||('Команда обработана: '+$json.status)}}];"},"id":"ap-msg","name":"Build Telegram result","type":"n8n-nodes-base.code","typeVersion":2,"position":[500,-60]},
      {"parameters":{"chatId":"={{$json.chat_id}}","text":"={{$json.text}}","additionalFields":{}},"id":"ap-send","name":"Telegram — result","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[740,-60],"credentials":{"telegramApi":{"id":"rIVYVtqdOx6zlczs","name":"Telegram account"}}}
