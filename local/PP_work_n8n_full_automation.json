        "parameters": {"mode":"mergeByIndex"},"id":"cf-merge","name":"Merge DB + trends","type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[-200,80]
      },
      {
        "parameters":{"modelId":{"__rl":true,"value":"gpt-5.4-mini","mode":"list"},"responses":{"values":[{"content":"=Ты — редактор-аналитик Дзена. Сгенерируй 12 свежих тем для канала «AI для жизни и бизнеса» на основе RSS-трендов и списка уже использованных тем. Не повторяй темы за последние 30 дней. Выбирай практичные темы для широкой аудитории. Верни только валидный JSON без markdown: {\"topics\":[{\"title\":\"...\",\"topic_key\":\"...\",\"angle\":\"...\",\"trend_source\":\"...\"}]}\n\nУже использованные записи:\n{{ JSON.stringify($('Supabase — recent topics').all().map(i=>i.json)) }}\n\nRSS-тренды:\n{{ $('Trends — Google News RSS').first().json.data || JSON.stringify($('Trends — Google News RSS').first().json) }}"}]},"options":{}},
        "id":"cf-topic-ai","name":"Topic Agent — trends + uniqueness","type":"@n8n/n8n-nodes-langchain.openAi","typeVersion":2.3,"position":[40,80],"credentials":{"openAiApi":{"id":"DvKIYMkfaAw0ATe0","name":"OpenAI account 2"}}
      },
      {
        "parameters":{"jsCode":"const raw=$json.output?.[0]?.content?.[0]?.text||$json.text||''; const clean=raw.replace(/^```json\\s*|```$/g,'').trim(); let x; try{x=JSON.parse(clean)}catch(e){x={topics:[{title:'Как использовать нейросети для экономии времени каждый день',topic_key:'ai-time-saving',angle:'Практическая инструкция',trend_source:'fallback'}]};} const topics=x.topics||[]; const pick=topics[Math.floor(Math.random()*Math.max(topics.length,1))]||topics[0]; return [{json:{...pick,run_id:$('Config').first().json.run_id,chat_id:$('Config').first().json.chat_id,supabase_url:$('Config').first().json.supabase_url,created_at:new Date().toISOString()}}];"},
        "id":"cf-pick","name":"Pick unique topic","type":"n8n-nodes-base.code","typeVersion":2,"position":[280,80]
      },
      {
        "parameters":{"modelId":{"__rl":true,"value":"gpt-5.4-mini","mode":"list"},"responses":{"values":[{"content":"=Ты — профессиональный автор статьи для Дзена. Напиши полезную статью 1500–2000 слов на тему: {{ $json.title }}. Угол подачи: {{ $json.angle }}. Стиль простой, живой, без канцелярита. Верни JSON без markdown: {\"title\":\"...\",\"content\":\"...\",\"keywords\":[\"...\"],\"affiliate_intent\":\"...\"}. Не выдумывай факты, не упоминай ИИ как автора."}]},"options":{}},
        "id":"cf-writer","name":"Article Writer","type":"@n8n/n8n-nodes-langchain.openAi","typeVersion":2.3,"position":[520,80],"credentials":{"openAiApi":{"id":"DvKIYMkfaAw0ATe0","name":"OpenAI account 2"}}
      },
      {
        "parameters":{"modelId":{"__rl":true,"value":"gpt-5.4-mini","mode":"list"},"responses":{"values":[{"content":"=Ты — SEO-редактор и QA. Получи статью ниже. Верни JSON без markdown: {\"title\":\"финальный заголовок\",\"content\":\"готовый текст\",\"description\":\"описание до 160 символов\",\"keywords\":[\"...\"],\"qa\":{\"facts_ok\":true,\"readability\":\"...\"}}. Сохрани смысл, убери повторы, сделай короткие абзацы и подзаголовки. Не добавляй неподтверждённые сведения.\n\n{{ $json.output?.[0]?.content?.[0]?.text || JSON.stringify($json) }}"}]},"options":{}},
        "id":"cf-seo","name":"SEO + QA Agent","type":"@n8n/n8n-nodes-langchain.openAi","typeVersion":2.3,"position":[760,80],"credentials":{"openAiApi":{"id":"DvKIYMkfaAw0ATe0","name":"OpenAI account 2"}}
      },
      {
        "parameters":{"modelId":{"__rl":true,"value":"gpt-5.4-mini","mode":"list"},"responses":{"values":[{"content":"=Ты — менеджер партнёрских офферов. Из текста статьи выбери максимум один релевантный оффер из списка. Если подходящего нет — affiliate_url оставь пустым. Не выдумывай ссылки. Верни JSON: {\"affiliate_name\":\"...\",\"affiliate_url\":\"...\",\"placement\":\"...\",\"disclosure\":\"Реклама\"}. Офферы: AI SaaS — https://example.com/ai?utm_source=dzen&utm_medium=article; VPS — https://example.com/vps?utm_source=dzen&utm_medium=article; VPN — https://example.com/vpn?utm_source=dzen&utm_medium=article.\n\nСтатья:\n{{ $json.output?.[0]?.content?.[0]?.text || JSON.stringify($json) }}"}]},"options":{}},
        "id":"cf-aff","name":"Affiliate Selector + UTM","type":"@n8n/n8n-nodes-langchain.openAi","typeVersion":2.3,"position":[1000,80],"credentials":{"openAiApi":{"id":"DvKIYMkfaAw0ATe0","name":"OpenAI account 2"}}
      },
      {
        "parameters":{"method":"GET","url":"=https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrsearch={{ encodeURIComponent($('Pick unique topic').first().json.title) }}&gsrnamespace=6&gsrlimit=5&prop=imageinfo&iiprop=url&iiurlwidth=1200&format=json","options":{}},
        "id":"cf-images","name":"Images — Wikimedia Commons (3–5)","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1000,300]
