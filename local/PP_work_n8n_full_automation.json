        "parameters":{"jsCode":"const a=$('Build article package').first().json; const preview=a.content.slice(0,2500); return [{json:{chat_id:a.chat_id,text:'Новая статья на проверку\\n\\n'+a.title+'\\n\\n'+preview+'\\n\\nID: '+a.run_id+'\\n\\nДля подтверждения: /approve '+a.run_id+'\\nДля отклонения: /reject '+a.run_id+'\\nДля доработки: /revise '+a.run_id}}];"},
