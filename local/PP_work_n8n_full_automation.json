      {
        "parameters":{"mode":"mergeByIndex"},"id":"cf-final-merge","name":"Merge article + affiliate + images","type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[1240,100]
      },
      {
        "parameters":{"jsCode":"const topic=$('Pick unique topic').first().json; const seoRaw=$('SEO + QA Agent').first().json.output?.[0]?.content?.[0]?.text||''; const affRaw=$('Affiliate Selector + UTM').first().json.output?.[0]?.content?.[0]?.text||''; const parse=s=>{try{return JSON.parse(s.replace(/^```json\\s*|```$/g,'').trim())}catch(e){return {}}}; const seo=parse(seoRaw), aff=parse(affRaw); const pages=$json.query?.pages||{}; const images=Object.values(pages).map(p=>p.imageinfo?.[0]?.thumburl||p.imageinfo?.[0]?.url).filter(Boolean).slice(0,5); const title=seo.title||topic.title; let content=seo.content||seoRaw; if(aff.affiliate_url) content+='\\n\\n'+(aff.placement||'Полезный сервис по теме статьи:')+' '+aff.affiliate_url+'\\n'+(aff.disclosure||'Реклама'); const hash=Buffer.from(title+'|'+content).toString('base64').slice(0,64); return [{json:{run_id:topic.run_id,title,content,description:seo.description||'',keywords:seo.keywords||[],topic_key:topic.topic_key,title_normalized:title.toLowerCase().replace(/[^a-zа-я0-9]+/gi,' ').trim(),content_hash:hash,image_urls:images,status:'awaiting_approval',created_at:topic.created_at,chat_id:topic.chat_id,supabase_url:topic.supabase_url,affiliate_url:aff.affiliate_url||''}}];"},
        "id":"cf-package","name":"Build article package","type":"n8n-nodes-base.code","typeVersion":2,"position":[1480,100]
